{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OxRefine",
  "version": "0.6.0",
  "identifier": "dev.oxrefine.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OxRefine",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "OxRefine contributors",
    "copyright": "Copyright (c) 2026 OxRefine contributors. MIT License.",
    "category": "Productivity",
    "shortDescription": "Clean messy data, the OpenRefine way, at native speed",
    "longDescription": "OxRefine is an open-source OpenRefine alternative: facet, cluster, transform and reconcile messy CSV, Excel and JSON data, with OpenRefine-compatible recipes and projects.",
    "homepage": "https://github.com/ilyaux/OxRefine",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../crates/ox-core/assets/commons-codec/LICENSE.txt": "licenses/commons-codec/LICENSE.txt",
      "../../crates/ox-core/assets/language-detector/LICENSE.txt": "licenses/language-detector/LICENSE.txt",
      "../../crates/ox-core/assets/language-detector/CREDITS.md": "licenses/language-detector/CREDITS.md",
      "../../crates/ox-core/assets/language-detector/UPSTREAM-README.md": "licenses/language-detector/UPSTREAM-README.md",
      "../../crates/ox-core/assets/marc8/README.md": "licenses/marc8/README.md",
      "../../crates/ox-core/assets/marc8/provenance.json": "licenses/marc8/provenance.json",
      "../../licenses/README.md": "licenses/README.md",
      "../../licenses/OpenRefine-3.10.1.txt": "licenses/OpenRefine-3.10.1.txt",
      "../../licenses/parse_wiki_text-0.1.5.txt": "licenses/parse_wiki_text-0.1.5.txt",
      "../node_modules/@fontsource-variable/geist/LICENSE": "licenses/geist/LICENSE",
      "../node_modules/@fontsource-variable/geist-mono/LICENSE": "licenses/geist-mono/LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEQzBBN0ExODEyQUI5MzcKUldRM3VTcUJvYWZBalhBOGsveEN1V29sMWtWaWVlcFZxRndVbzd0WlJ6YkhsRmZFY2lnS0ZMUXMK",
      "endpoints": [
        "https://github.com/ilyaux/OxRefine/releases/latest/download/latest.json"
      ]
    }
  }
}
