# Test data is compared byte for byte with what OpenRefine read: never convert its line endings
# (tests/corpus has CRLF, CR-only and mixed files on purpose).
tests/**/*.csv -text
tests/**/*.tsv -text
tests/**/*.txt -text
tests/**/*.json -text
tests/**/*.fods -text
tests/**/*.xml -text
tests/**/*.gz binary
tests/**/*.bz2 binary
tests/**/*.zip binary
tests/**/*.ods binary
tests/**/*.xlsx binary

# Bundled rule files are read byte for byte
crates/ox-core/assets/** -text
